<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - MTRIET DZ</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0a0a0f;
            color: #eee;
            font-family: 'Orbitron', sans-serif;
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .dashboard { max-width: 800px; width: 100%; padding: 20px 0; }
        .header { text-align: center; padding: 20px 0 10px; border-bottom: 1px solid rgba(255,255,255,0.04); }
        .header h1 { font-size: 28px; background: linear-gradient(90deg, #f7971e, #ffd200); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: 2px; }
        .header .sub { color: #555577; font-size: 11px; letter-spacing: 3px; margin-top: 4px; }
        .vip-badge { display: inline-block; background: linear-gradient(90deg, #ff0055, #ffaa00); color: #fff; font-size: 10px; padding: 3px 14px; border-radius: 30px; letter-spacing: 1px; margin-left: 10px; text-shadow: 0 0 20px #ff005566; }
        .card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 28px; padding: 25px 20px; margin: 18px 0; backdrop-filter: blur(10px); transition: 0.3s; }
        .card:hover { border-color: rgba(247,151,30,0.15); box-shadow: 0 0 40px rgba(247,151,30,0.03); }
        .card h2 { font-size: 16px; letter-spacing: 2px; color: #ccd; margin-bottom: 15px; border-left: 3px solid #f7971e; padding-left: 12px; }
        .card h2 small { font-size: 10px; color: #555577; letter-spacing: 1px; }
        .row { display: flex; flex-wrap: wrap; gap: 10px; }
        .toggle-item { display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.02); padding: 10px 15px; border-radius: 40px; border: 1px solid rgba(255,255,255,0.03); flex: 1 1 calc(50% - 10px); min-width: 160px; transition: 0.2s; }
        .toggle-item:hover { background: rgba(255,255,255,0.04); }
        .toggle-item label { font-size: 11px; letter-spacing: 0.5px; color: #aaaac0; }
        .switch { position: relative; display: inline-block; width: 40px; height: 20px; flex-shrink: 0; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #222244; transition: .3s; border-radius: 20px; }
        .slider:before { position: absolute; content: ""; height: 14px; width: 14px; left: 3px; bottom: 3px; background: #444466; transition: .3s; border-radius: 50%; }
        input:checked + .slider { background: linear-gradient(90deg, #f7971e, #ffd200); }
        input:checked + .slider:before { transform: translateX(20px); background: #0a0a0f; }
        .btn-glow { display: inline-block; background: linear-gradient(90deg, #f7971e, #ffd200); border: none; border-radius: 50px; padding: 14px 30px; font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 13px; color: #0a0a0f; cursor: pointer; transition: 0.3s; letter-spacing: 2px; text-transform: uppercase; width: 100%; margin-top: 5px; }
        .btn-glow:hover { transform: scale(1.02); box-shadow: 0 0 50px rgba(247,151,30,0.2); }
        .btn-outline { background: transparent; border: 1px solid rgba(255,255,255,0.1); color: #aaaac0; padding: 12px 20px; border-radius: 50px; font-family: 'Orbitron', sans-serif; font-size: 11px; cursor: pointer; transition: 0.3s; letter-spacing: 1px; width: 100%; }
        .btn-outline:hover { border-color: #f7971e; color: #f7971e; }
        .unlock-area { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
        .unlock-area input { flex: 1; min-width: 120px; padding: 14px 18px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.03); color: #eee; font-family: 'Orbitron', sans-serif; font-size: 12px; outline: none; }
        .unlock-area input:focus { border-color: #f7971e; }
        .unlock-area .btn-glow { flex: 0 0 auto; width: auto; padding: 14px 30px; }
        .msg { font-size: 11px; margin-top: 8px; letter-spacing: 0.5px; }
        .msg.success { color: #00ff88; }
        .msg.error { color: #ff4466; }
        .logout-link { display: block; text-align: center; color: #333355; font-size: 10px; letter-spacing: 2px; margin-top: 30px; text-decoration: none; transition: 0.2s; }
        .logout-link:hover { color: #ff4466; }
        .module-group { margin-top: 20px; }
        .module-group .group-title { font-size: 13px; color: #8888aa; letter-spacing: 2px; margin-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 6px; }
        @media (max-width: 500px) { .toggle-item { flex: 1 1 100%; } .unlock-area input { min-width: 100%; } .unlock-area .btn-glow { width: 100%; } }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="header">
            <h1>✦ MTRIET DZ ✦</h1>
            <div class="sub">SUPREME ENGINE <span id="vipBadge" style="display:<%= unlocked ? 'inline' : 'none' %>;" class="vip-badge">VIP 100%</span></div>
        </div>

        <!-- TikTok & Zalo -->
        <div class="card" style="display:flex; gap:12px; padding:15px 20px;">
            <a href="https://www.tiktok.com/@mihtriet1221" target="_blank" class="btn-outline" style="text-align:center;">📱 TIKTOK</a>
            <a href="https://zalo.me/g/beslkt992" target="_blank" class="btn-outline" style="text-align:center;">💬 ZALO</a>
        </div>

        <!-- Unlock -->
        <div class="card">
            <h2>🔓 UNLOCK <small>nhập key để kích hoạt 100%</small></h2>
            <div class="unlock-area">
                <input type="text" id="unlockUser" placeholder="USERNAME" value="<%= user %>">
                <input type="text" id="unlockKey" placeholder="KEY">
                <button class="btn-glow" onclick="unlock()">UNLOCK</button>
            </div>
            <div id="unlockMsg" class="msg"></div>
        </div>

        <!-- Menu bật config (chỉ hiện khi unlock) -->
        <div id="menuModules" style="display: <%= unlocked ? 'block' : 'none' %>;">
            <div class="card">
                <h2>⚡ BẬT CONFIG VIP <small>mỗi cái = 1 cụm tham số</small></h2>

                <!-- Aim Lock -->
                <div class="module-group">
                    <div class="group-title">🔒 AIM LOCK</div>
                    <div class="row">
                        <div class="toggle-item"><label>Head</label><label class="switch"><input type="checkbox" onchange="toggle('aimlock','head',this.checked)" <%= (modules.aimlock && modules.aimlock.head) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Neck</label><label class="switch"><input type="checkbox" onchange="toggle('aimlock','neck',this.checked)" <%= (modules.aimlock && modules.aimlock.neck) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Snap</label><label class="switch"><input type="checkbox" onchange="toggle('aimlock','snap',this.checked)" <%= (modules.aimlock && modules.aimlock.snap) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Sticky</label><label class="switch"><input type="checkbox" onchange="toggle('aimlock','sticky',this.checked)" <%= (modules.aimlock && modules.aimlock.sticky) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Magnetic</label><label class="switch"><input type="checkbox" onchange="toggle('aimlock','magnetic',this.checked)" <%= (modules.aimlock && modules.aimlock.magnetic) ? 'checked' : '' %>><span class="slider"></span></label></div>
                    </div>
                </div>

                <!-- Assist Lock -->
                <div class="module-group">
                    <div class="group-title">🎯 ASSIST LOCK</div>
                    <div class="row">
                        <div class="toggle-item"><label>Drag</label><label class="switch"><input type="checkbox" onchange="toggle('assistlock','drag',this.checked)" <%= (modules.assistlock && modules.assistlock.drag) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Stick</label><label class="switch"><input type="checkbox" onchange="toggle('assistlock','stick',this.checked)" <%= (modules.assistlock && modules.assistlock.stick) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Pull</label><label class="switch"><input type="checkbox" onchange="toggle('assistlock','pull',this.checked)" <%= (modules.assistlock && modules.assistlock.pull) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Smooth</label><label class="switch"><input type="checkbox" onchange="toggle('assistlock','smooth',this.checked)" <%= (modules.assistlock && modules.assistlock.smooth) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Brake</label><label class="switch"><input type="checkbox" onchange="toggle('assistlock','brake',this.checked)" <%= (modules.assistlock && modules.assistlock.brake) ? 'checked' : '' %>><span class="slider"></span></label></div>
                    </div>
                </div>

                <!-- FPS Smooth -->
                <div class="module-group">
                    <div class="group-title">⚡ FPS SMOOTH</div>
                    <div class="row">
                        <div class="toggle-item"><label>Boost</label><label class="switch"><input type="checkbox" onchange="toggle('fpssmooth','boost',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.boost) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Adaptive</label><label class="switch"><input type="checkbox" onchange="toggle('fpssmooth','adaptive',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.adaptive) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Dynamic</label><label class="switch"><input type="checkbox" onchange="toggle('fpssmooth','dynamic',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.dynamic) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Lag Fix</label><label class="switch"><input type="checkbox" onchange="toggle('fpssmooth','lagfix',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.lagfix) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>GPU Boost</label><label class="switch"><input type="checkbox" onchange="toggle('fpssmooth','gpuboost',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.gpuboost) ? 'checked' : '' %>><span class="slider"></span></label></div>
                    </div>
                </div>

                <!-- Tăng Nhạy 999000 -->
                <div class="module-group">
                    <div class="group-title">📈 TĂNG NHẠY <small style="color:#f7971e;">999000</small></div>
                    <div class="row">
                        <div class="toggle-item"><label>Aim</label><label class="switch"><input type="checkbox" onchange="toggle('tagnhay','aim',this.checked)" <%= (modules.tagnhay && modules.tagnhay.aim) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Touch</label><label class="switch"><input type="checkbox" onchange="toggle('tagnhay','touch',this.checked)" <%= (modules.tagnhay && modules.tagnhay.touch) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Vertical</label><label class="switch"><input type="checkbox" onchange="toggle('tagnhay','vertical',this.checked)" <%= (modules.tagnhay && modules.tagnhay.vertical) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Swipe</label><label class="switch"><input type="checkbox" onchange="toggle('tagnhay','swipe',this.checked)" <%= (modules.tagnhay && modules.tagnhay.swipe) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Scope</label><label class="switch"><input type="checkbox" onchange="toggle('tagnhay','scope',this.checked)" <%= (modules.tagnhay && modules.tagnhay.scope) ? 'checked' : '' %>><span class="slider"></span></label></div>
                    </div>
                </div>

                <!-- Center Lock -->
                <div class="module-group">
                    <div class="group-title">🎯 CENTER LOCK</div>
                    <div class="row">
                        <div class="toggle-item"><label>Snap</label><label class="switch"><input type="checkbox" onchange="toggle('centerlock','snap',this.checked)" <%= (modules.centerlock && modules.centerlock.snap) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Stick</label><label class="switch"><input type="checkbox" onchange="toggle('centerlock','stick',this.checked)" <%= (modules.centerlock && modules.centerlock.stick) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Magnet</label><label class="switch"><input type="checkbox" onchange="toggle('centerlock','magnet',this.checked)" <%= (modules.centerlock && modules.centerlock.magnet) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Brake</label><label class="switch"><input type="checkbox" onchange="toggle('centerlock','brake',this.checked)" <%= (modules.centerlock && modules.centerlock.brake) ? 'checked' : '' %>><span class="slider"></span></label></div>
                        <div class="toggle-item"><label>Prediction</label><label class="switch"><input type="checkbox" onchange="toggle('centerlock','prediction',this.checked)" <%= (modules.centerlock && modules.centerlock.prediction) ? 'checked' : '' %>><span class="slider"></span></label></div>
                    </div>
                </div>

                <button class="btn-glow" onclick="downloadConfig()" style="margin-top:15px;">📥 TẢI CONFIG TỔNG HỢP</button>
            </div>
        </div>

        <a href="/logout" class="logout-link">⏻ ĐĂNG XUẤT</a>
    </div>

    <script>
        async function unlock() {
            const username = document.getElementById('un
