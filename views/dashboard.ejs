<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - MTRIET DZ</title>
    <style>
        body { background: #0f0c29; color: #fff; font-family: Arial; text-align: center; padding: 20px; }
        .card { background: rgba(255,255,255,0.05); border-radius: 20px; padding: 20px; margin: 15px auto; max-width: 500px; }
        .btn { background: #f7971e; color: #000; padding: 10px 20px; border-radius: 30px; border: none; font-weight: bold; cursor: pointer; }
        .toggle { display: flex; justify-content: space-between; align-items: center; margin: 8px 0; }
        .switch { position: relative; display: inline-block; width: 44px; height: 22px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #555; transition: .3s; border-radius: 22px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background: #fff; transition: .3s; border-radius: 50%; }
        input:checked + .slider { background: #f7971e; }
        input:checked + .slider:before { transform: translateX(22px); }
        .vip-status { color: #ffcc00; font-weight: bold; }
        .unlock-area { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 20px; margin-top: 10px; }
        input[type="text"] { background: rgba(255,255,255,0.1); border: 1px solid #555; border-radius: 30px; padding: 10px 15px; color: #fff; width: 70%; margin: 5px; }
        .msg.success { color: #00ff88; }
        .msg.error { color: #ff4466; }
        .social-row { display: flex; gap: 10px; margin: 10px 0; }
        .social-btn { flex: 1; padding: 10px; border-radius: 50px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); color: #fff; font-weight: bold; cursor: pointer; text-decoration: none; }
        .social-btn.tiktok { color: #ff0050; border-color: #ff005066; }
        .social-btn.zalo { color: #0068ff; border-color: #0068ff66; }
        .logout { color: #ff6b6b; display: block; margin-top: 20px; }
        .btn-glow { display: inline-block; background: linear-gradient(90deg, #f7971e, #ffd200); border: none; border-radius: 50px; padding: 14px 30px; font-family: Arial, sans-serif; font-weight: bold; font-size: 13px; color: #0a0a0f; cursor: pointer; transition: 0.3s; letter-spacing: 2px; text-transform: uppercase; width: 100%; margin-top: 5px; }
        .btn-glow:hover { transform: scale(1.02); box-shadow: 0 0 50px rgba(247,151,30,0.2); }
    </style>
</head>
<body>
    <h1>✦ MTRIET DZ ✦</h1>
    <p>Chào <strong style="color:#f7971e;"><%= user %></strong>
        <span id="vipBadge" class="vip-status" style="display: <%= unlocked ? 'inline' : 'none' %>;">⭐ VIP 100%</span>
    </p>

    <div class="social-row">
        <a href="https://www.tiktok.com/@mihtriet1221" target="_blank" class="social-btn tiktok">📱 TIKTOK</a>
        <a href="https://zalo.me/g/beslkt992" target="_blank" class="social-btn zalo">💬 ZALO</a>
    </div>

    <div class="card unlock-area">
        <h2>🔓 UNLOCK FULL POWER</h2>
        <input type="text" id="unlockUser" placeholder="Username" value="<%= user %>">
        <input type="text" id="unlockKey" placeholder="Key">
        <button class="btn" onclick="unlock()">UNLOCK</button>
        <div id="unlockMsg" class="msg"></div>
    </div>

    <div id="menuModules" style="display: <%= unlocked ? 'block' : 'none' %>;">
        <div class="card">
            <h2>⚙️ BẬT / TẮT MODULES</h2>
            <!-- Aim Lock -->
            <div class="toggle"><label>🔒 Aim Lock - Head</label><label class="switch"><input type="checkbox" id="aimlock_head" onchange="toggle('aimlock','head',this.checked)" <%= (modules.aimlock && modules.aimlock.head) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🔒 Aim Lock - Neck</label><label class="switch"><input type="checkbox" id="aimlock_neck" onchange="toggle('aimlock','neck',this.checked)" <%= (modules.aimlock && modules.aimlock.neck) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🔒 Aim Lock - Snap</label><label class="switch"><input type="checkbox" id="aimlock_snap" onchange="toggle('aimlock','snap',this.checked)" <%= (modules.aimlock && modules.aimlock.snap) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🔒 Aim Lock - Sticky</label><label class="switch"><input type="checkbox" id="aimlock_sticky" onchange="toggle('aimlock','sticky',this.checked)" <%= (modules.aimlock && modules.aimlock.sticky) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🔒 Aim Lock - Magnetic</label><label class="switch"><input type="checkbox" id="aimlock_magnetic" onchange="toggle('aimlock','magnetic',this.checked)" <%= (modules.aimlock && modules.aimlock.magnetic) ? 'checked' : '' %>><span class="slider"></span></label></div>

            <!-- Assist Lock -->
            <div class="toggle"><label>🎯 Assist Lock - Drag</label><label class="switch"><input type="checkbox" id="assistlock_drag" onchange="toggle('assistlock','drag',this.checked)" <%= (modules.assistlock && modules.assistlock.drag) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Assist Lock - Stick</label><label class="switch"><input type="checkbox" id="assistlock_stick" onchange="toggle('assistlock','stick',this.checked)" <%= (modules.assistlock && modules.assistlock.stick) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Assist Lock - Pull</label><label class="switch"><input type="checkbox" id="assistlock_pull" onchange="toggle('assistlock','pull',this.checked)" <%= (modules.assistlock && modules.assistlock.pull) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Assist Lock - Smooth</label><label class="switch"><input type="checkbox" id="assistlock_smooth" onchange="toggle('assistlock','smooth',this.checked)" <%= (modules.assistlock && modules.assistlock.smooth) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Assist Lock - Brake</label><label class="switch"><input type="checkbox" id="assistlock_brake" onchange="toggle('assistlock','brake',this.checked)" <%= (modules.assistlock && modules.assistlock.brake) ? 'checked' : '' %>><span class="slider"></span></label></div>

            <!-- FPS Smooth -->
            <div class="toggle"><label>⚡ FPS Smooth - Boost</label><label class="switch"><input type="checkbox" id="fpssmooth_boost" onchange="toggle('fpssmooth','boost',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.boost) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>⚡ FPS Smooth - Adaptive</label><label class="switch"><input type="checkbox" id="fpssmooth_adaptive" onchange="toggle('fpssmooth','adaptive',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.adaptive) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>⚡ FPS Smooth - Dynamic</label><label class="switch"><input type="checkbox" id="fpssmooth_dynamic" onchange="toggle('fpssmooth','dynamic',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.dynamic) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>⚡ FPS Smooth - Lag Fix</label><label class="switch"><input type="checkbox" id="fpssmooth_lagfix" onchange="toggle('fpssmooth','lagfix',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.lagfix) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>⚡ FPS Smooth - GPU Boost</label><label class="switch"><input type="checkbox" id="fpssmooth_gpuboost" onchange="toggle('fpssmooth','gpuboost',this.checked)" <%= (modules.fpssmooth && modules.fpssmooth.gpuboost) ? 'checked' : '' %>><span class="slider"></span></label></div>

            <!-- Tăng Nhạy -->
            <div class="toggle"><label>📈 Tăng Nhạy - Aim</label><label class="switch"><input type="checkbox" id="tagnhay_aim" onchange="toggle('tagnhay','aim',this.checked)" <%= (modules.tagnhay && modules.tagnhay.aim) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>📈 Tăng Nhạy - Touch</label><label class="switch"><input type="checkbox" id="tagnhay_touch" onchange="toggle('tagnhay','touch',this.checked)" <%= (modules.tagnhay && modules.tagnhay.touch) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>📈 Tăng Nhạy - Vertical</label><label class="switch"><input type="checkbox" id="tagnhay_vertical" onchange="toggle('tagnhay','vertical',this.checked)" <%= (modules.tagnhay && modules.tagnhay.vertical) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>📈 Tăng Nhạy - Swipe</label><label class="switch"><input type="checkbox" id="tagnhay_swipe" onchange="toggle('tagnhay','swipe',this.checked)" <%= (modules.tagnhay && modules.tagnhay.swipe) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>📈 Tăng Nhạy - Scope</label><label class="switch"><input type="checkbox" id="tagnhay_scope" onchange="toggle('tagnhay','scope',this.checked)" <%= (modules.tagnhay && modules.tagnhay.scope) ? 'checked' : '' %>><span class="slider"></span></label></div>

            <!-- Center Lock -->
            <div class="toggle"><label>🎯 Center Lock - Snap</label><label class="switch"><input type="checkbox" id="centerlock_snap" onchange="toggle('centerlock','snap',this.checked)" <%= (modules.centerlock && modules.centerlock.snap) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Center Lock - Stick</label><label class="switch"><input type="checkbox" id="centerlock_stick" onchange="toggle('centerlock','stick',this.checked)" <%= (modules.centerlock && modules.centerlock.stick) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Center Lock - Magnet</label><label class="switch"><input type="checkbox" id="centerlock_magnet" onchange="toggle('centerlock','magnet',this.checked)" <%= (modules.centerlock && modules.centerlock.magnet) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Center Lock - Brake</label><label class="switch"><input type="checkbox" id="centerlock_brake" onchange="toggle('centerlock','brake',this.checked)" <%= (modules.centerlock && modules.centerlock.brake) ? 'checked' : '' %>><span class="slider"></span></label></div>
            <div class="toggle"><label>🎯 Center Lock - Prediction</label><label class="switch"><input type="checkbox" id="centerlock_prediction" onchange="toggle('centerlock','prediction',this.checked)" <%= (modules.centerlock && modules.centerlock.prediction) ? 'checked' : '' %>><span class="slider"></span></label></div>

            <button class="btn-glow" onclick="activateAll()" style="margin-top:15px; background: linear-gradient(90deg, #00ff88, #00ccff);">🚀 KÍCH HOẠT TẤT CẢ</button>
            <button class="btn" onclick="downloadConfig()" style="margin-top:10px;">📥 TẢI CONFIG TỔNG HỢP</button>
        </div>
    </div>

    <a href="/logout" class="logout">Đăng xuất</a>

    <script>
        async function unlock() {
            const username = document.getElementById('unlockUser').value;
            const key = document.getElementById('unlockKey').value;
            const msg = document.getElementById('unlockMsg');
            try {
                const res = await fetch('/unlock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, key })
                });
                const text = await res.text();
                if (res.ok) {
                    msg.className = 'msg success';
                    msg.textContent = '✅ UNLOCK THÀNH CÔNG! Đang tải menu...';
                    document.getElementById('vipBadge').style.display = 'inline';
                    document.getElementById('menuModules').style.display = 'block';
                } else {
                    msg.className = 'msg error';
                    msg.textContent = '❌ Sai username hoặc key! (phản hồi: ' + text + ')';
                }
            } catch (e) {
                msg.className = 'msg error';
                msg.textContent = '❌ Lỗi kết nối: ' + e.message;
            }
        }

        async function toggle(module, sub, enabled) {
            const res = await fetch('/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ module, sub, enabled })
            });
            if (!res.ok) alert('Lỗi bật/tắt module!');
        }

        function downloadConfig() {
            window.open('/config-web', '_blank');
        }

        async function activateAll() {
            const msg = document.getElementById('unlockMsg');
            try {
                const res = await fetch('/activate-all', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (res.ok) {
                    document.querySelectorAll('.switch input[type="checkbox"]').forEach(cb => cb.checked = true);
                    msg.className = 'msg success';
                    msg.textContent = '✅ Đã kích hoạt tất cả module! Chuyển trang...';
                    setTimeout(() => {
                        window.location.href = '/done';
                    }, 1500);
                } else {
                    msg.className = 'msg error';
                    msg.textContent = '❌ Lỗi khi kích hoạt tất cả!';
                }
            } catch (e) {
                msg.className = 'msg error';
                msg.textContent = '❌ Lỗi kết nối: ' + e.message;
            }
        }
    </script>
</body>
</html>
